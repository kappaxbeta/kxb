  "scripts": {
    "kick": "/**\n * One script for everything you can hit, and it is the same three lines each\n * time.\n *\n * Every kickable thing in the playground shares this - the loose balls, the\n * skittles, the bowling ball, the floaters, the boulder - and none of them\n * needs a variant, because what makes them different is on their **blueprints**\n * rather than in here. A floater is `gravity: 0`, a boulder is `mass: 30`, a\n * skittle is light and does not bounce. The script does not know or care which\n * one it is running on, and that is the whole argument for putting physics in\n * the format rather than in a file per object.\n *\n * The rule beside each blueprint decides *when*, and the pace is measured from\n * where the player was last frame - a level has no reading of how fast anybody\n * is going, and one frame of positions is exactly that.\n */\nconst BASE = 8\nconst CARRY = 1.6\nconst LOFT = 0.3\n\nlet wasX = null\nlet wasZ = null\nlet pace = 0\n\nfunction onTick(dt) {\n  const player = getEntityByName('player')\n  if (player) {\n    if (wasX !== null && dt > 0) {\n      const moved = Math.sqrt((player.x - wasX) * (player.x - wasX) + (player.z - wasZ) * (player.z - wasZ))\n      const speed = moved / dt\n      // A jump in position is a teleport rather than a sprint, and reading it\n      // as one would fire the thing out of the playground.\n      pace = speed > 30 ? pace : speed\n    }\n    wasX = player.x\n    wasZ = player.z\n  }\n\n  if (self.get('kicked') > 0) {\n    self.set('kicked', 0)\n    if (player) {\n      const dx = self.x - player.x\n      const dy = self.y - player.y\n      const dz = self.z - player.z\n      const away = Math.sqrt(dx * dx + dz * dz)\n      // Up as well as along, because a floater is above your head and a kick\n      // that only ever went sideways would be unable to reach one at all.\n      if (away > 0.001 && Math.abs(dy) < 3) {\n        const power = BASE + pace * CARRY\n        // Divided by its own mass inside `push`, so the same kick that sends a\n        // ball across the yard barely rocks the boulder - and the script does\n        // not have to know which one it just hit.\n        self.push((dx / away) * power, power * LOFT, (dz / away) * power)\n      }\n    }\n  }\n}\n\n/**\n * A noise when it lands hard, and nothing when it settles.\n *\n * `hit` is the level itself - the floor, a wall, a spring pad - as opposed to\n * `collide`, which is another thing in the yard. The speed test is what keeps\n * it a clatter rather than a drone: a body that has stopped reports nothing at\n * all, so this only ever fires on an arrival worth hearing.\n */\nfunction onTrigger(event) {\n  if (event === 'hit' && self.speed > 7) self.emit('clatter')\n}\n"
  },
