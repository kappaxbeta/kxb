{
  "format": "xp/1",
  "id": "shooter",
  "name": "Shooter",
  "blurb": "The demo the rest of it was for, grown into a range you have to move around: forty cells of it on two floors, a gallery of targets that get back up, two that run, a bunker you shoot into through a window, and mines that come looking for you - every one of which is a rule or a script in this file rather than code in the runtime.",
  "finish": "galaxy",
  "packs": [
    {
      "id": "proto"
    },
    {
      "id": "dummy"
    }
  ],
  "capabilities": [
    "freeplay",
    "match"
  ],
  "rules": {
    "preset": "shooter",
    "scoreLimit": 60,
    "timeLimit": 420,
    "respawn": 4,
    "players": {
      "min": 1,
      "max": 8
    }
  },
