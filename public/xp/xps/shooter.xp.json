    "blueprint": "marksman",
    "weapon": {
      "blueprint": "pistol",
      "socket": "hand"
    }
  },
  "scripts": {
    "rail": "/**\n * A target that will not stand still.\n *\n * Where it is, is worked out from the clock rather than accumulated frame by\n * frame - `world.time` is the one number every client in the room agrees\n * about, so four browsers draw this in the same place without anybody sending\n * anything, and a runner that was shot down and came back rejoins the sweep\n * instead of starting again from wherever it happened to die.\n *\n * The middle of the sweep is a property rather than where it was placed. Both\n * runners sweep across the middle of the gallery, and both had to be *placed*\n * out at the ends of it: the lane down the centre is the shot you are given on\n * arrival, and there is a test that fires it.\n */\nconst PACE = 0.42\n\nlet phase = 0\n\nfunction onSpawn() {\n  // Staggered by where it starts, so two runners are not one thick runner.\n  phase = self.x * 0.21\n}\n\nfunction onTick() {\n  self.x = self.get('centre') + Math.sin(world.time * PACE + phase) * self.get('span')\n}",
    "mine": "/**\n * The thing that shoots back, as near as a level can get to one.\n *\n * A script can measure a distance and take health off; it cannot cast a ray,\n * so it cannot fire. What it can do is come to you, and that is what this is:\n * a mine that circles its own patch of the pit until somebody walks inside its\n * reach, closes the distance, and goes off in their face.\n *\n * Three numbers make it fair rather than annoying. It flies above head height\n * and above every crate and cube in the pit, so what it costs you is the open\n * ground rather than the cover; it has a reload, so being caught once is a\n * hit and not a grinder; and it is two shots to bring down, which is worth\n * more than anything standing still on the far wall.\n *\n * ---------------------------------------------------------------------------\n * What it does in a room with other people in it\n * ---------------------------------------------------------------------------\n * `getEntityByName('player')` is *this* browser's player and there is no other\n * kind - so in a room of four, four mines chase four people, each on its own\n * screen. That is the honest reading of it for a range everybody is shooting\n * in at once, and it is deliberately the only divergence: where the mine flies\n * when nobody is near it comes off `world.time`, which is agreed, so the\n * moment it stops chasing it is back on the circle everybody can see.\n */\nconst RING = 5\nconst HEIGHT = 3.6\nconst AGGRO = 11\nconst STING = 2\nconst PACE = 3.6\nconst HURT = 18\nconst RELOAD = 7\nconst DEGREES = 180 / Math.PI\n\nlet homeX = null\nlet homeZ = null\nlet ready = 0\n\nfunction onTick(dt) {\n  if (homeX === null) {\n    homeX = self.x\n    homeZ = self.z\n  }\n\n  const player = getEntityByName('player')\n  const reach = player ? self.flatDistanceTo(player) : 999\n\n  if (player && world.time >= ready && reach < AGGRO) {\n    const dx = player.x - self.x\n    const dz = player.z - self.z\n    const away = Math.sqrt(dx * dx + dz * dz) || 1\n    self.moveTo(self.x + (dx / away) * PACE * dt, HEIGHT, self.z + (dz / away) * PACE * dt)\n    self.rotation = Math.atan2(dx, dz) * DEGREES\n\n    if (reach < STING) {\n      player.damage(HURT)\n      self.emit('a mine went off')\n      ready = world.time + RELOAD\n    }\n    return\n  }\n\n  // Its circuit, and it is *eased* back on to rather than snapped: one that\n  // has just stung somebody drifts back out over a second or so, which is the\n  // whole of what reading as \"it is backing off\" needs.\n  const angle = world.time * 0.6 + homeX\n  const wantX = homeX + Math.cos(angle) * RING\n  const wantZ = homeZ + Math.sin(angle) * RING\n  const ease = Math.min(1, dt * 1.5)\n  self.moveTo(self.x + (wantX - self.x) * ease, HEIGHT, self.z + (wantZ - self.z) * ease)\n  self.rotation = (self.rotation + dt * 120) % 360\n}",
    "dust": "/**\n * A piece of something that has been shot, on its way to not being there.\n *\n * Debris used to be forever, which was fine when everything in the level broke\n * once. Half of what is in here now comes back - a popper is up again in six\n * seconds - so without this the floor of the gallery is a carpet of shards by\n * the end of a round, every one of them an entity being walked past sixty\n * times a second.\n */\nconst LASTS = 8\n\nlet until = 0\n\nfunction onSpawn() {\n  until = world.time + LASTS\n}\n\nfunction onTick() {\n  if (until > 0 && world.time >= until) self.despawn()\n}"
  },
