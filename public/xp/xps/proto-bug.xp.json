              "sound": "tap"
            },
            {
              "op": "emit",
              "event": "task-done"
            }
          ]
        }
      ]
    },
    "cargo": {
      "model": "proto/Box_A",
      "collider": "auto",
      "triggers": [
        {
          "on": "pressed",
          "key": "use",
          "within": 2,
          "when": {
            "prop": "held",
            "is": "==",
            "value": 0
          },
          "do": [
            {
              "op": "setProp",
              "key": "hauling",
              "value": 1,
              "target": "other"
            },
            {
              "op": "carry",
              "target": "self",
              "socket": "hand"
            },
            {
              "op": "sound",
              "sound": "pickup"
            }
          ]
        }
      ]
    },
    "bay": {
      "model": "furniture/rug_rectangle_A",
      "collider": "auto",
      "triggers": [
        {
          "on": "enter",
          "when": {
            "of": "other",
            "prop": "hauling",
            "is": "==",
            "value": 1
          },
          "do": [
            {
              "op": "unhand",
              "target": "other"
            },
            {
              "op": "setProp",
              "key": "hauling",
              "value": 0,
              "target": "other"
            },
            {
              "op": "addProp",
              "key": "hauls",
              "value": 1,
              "target": "world"
            },
            {
              "op": "addProp",
              "key": "tasks",
              "value": 1,
              "target": "world"
            },
            {
              "op": "score",
              "amount": 1
            },
            {
              "op": "sound",
              "sound": "drop"
            },
            {
              "op": "emit",
              "event": "cargo-delivered"
            }
          ]
        }
      ]
    },
    "hatch": {
      "model": "proto/Door_A",
      "collider": "auto",
      "triggers": [
        {
          "on": "pressed",
          "key": "use",
          "within": 2,
          "when": {
            "of": "world",
            "prop": "tasks",
            "is": ">=",
            "value": 12
          },
          "do": [
            {
              "op": "despawn",
              "target": "self"
            },
            {
              "op": "sound",
              "sound": "fanfare"
            },
            {
              "op": "emit",
              "event": "shift-over"
            }
          ]
        }
      ]
    },
    "crate": {
      "model": "proto/Box_C",
