{
  "format": "xp/1",
  "id": "proto-bug",
  "name": "Proto Bug",
  "blurb": "One of you is a bug, and only the bug's gun works. The rest have work to do: finish every task, or call a meeting and vote it out before it finishes you.",
  "finish": "galaxy",
  "packs": [
    {
      "id": "proto"
    },
    {
      "id": "dummy"
    },
    {
      "id": "furniture"
    }
  ],
  "capabilities": [
    "freeplay",
    "match"
  ],
  "backend": {
    "needs": [
      "identity",
      "network",
      "arbiter"
    ],
    "wants": [
      "persistence"
    ]
  },
  "rules": {
    "preset": "shooter",
    "scoreLimit": 12,
    "timeLimit": 600,
    "players": {
      "min": 3,
      "max": 10
    },
    "roles": [
      "bug",
      "crew",
      "crew",
      "crew",
      "crew",
      "crew",
      "crew",
      "crew",
      "crew",
      "crew"
    ],
    "lethal": "bug",
    "respawn": 5
  },
  "data": {
    "tasks": {
      "scope": "space",
      "value": 0,
      "label": "Tasks finished"
    },
    "hauls": {
      "scope": "space",
      "value": 0,
      "label": "Cargo delivered"
    },
    "shifts": {
      "scope": "player",
      "value": 0,
      "label": "Shifts worked"
    }
  },
  "player": {
    "blueprint": "crewbody",
    "weapon": {
      "blueprint": "debugger",
      "socket": "hand"
    },
    "keys": [
      {
        "key": "KeyE",
        "does": "use"
      }
    ]
  },
  "blueprints": {
    "crewbody": {
      "model": "dummy/Dummy",
      "collider": "none",
      "tags": [
        "player"
      ],
      "props": {
        "hp": 100,
        "hauling": 0
      },
      "sockets": {
        "hand": {
          "x": 0.32,
          "y": 1.15,
          "z": 0.34
        }
      },
      "triggers": [
        {
          "on": "dealt",
          "when": {
            "prop": "bug",
            "is": "==",
            "value": 1
          },
          "do": [
            {
              "op": "sound",
              "sound": "hit"
            }
          ]
        }
      ]
    },
    "debugger": {
      "model": "proto/Gun_Pistol",
      "collider": "none",
      "tags": [
        "weapon"
      ],
      "sockets": {
        "muzzle": {
          "x": 0,
          "y": 0.06,
          "z": 0.28
        }
      }
    },
    "console": {
      "model": "furniture/monitor",
      "collider": "auto",
      "props": {
        "done": 0
      },
      "triggers": [
        {
          "on": "pressed",
          "key": "use",
          "within": 2,
          "when": {
            "prop": "done",
            "is": "==",
            "value": 0
          },
          "do": [
            {
              "op": "setProp",
              "key": "done",
              "value": 1,
              "target": "self"
            },
            {
              "op": "addProp",
              "key": "tasks",
              "value": 1,
              "target": "world"
            },
            {
              "op": "addProp",
              "key": "shifts",
              "value": 1,
              "target": "world"
            },
            {
              "op": "score",
              "amount": 1
            },
            {
              "op": "sound",
              "sound": "click"
            },
            {
              "op": "emit",
              "event": "task-done"
            }
          ]
        }
      ]
    },
    "valve": {
      "model": "proto/Barrel_A",
      "collider": "auto",
      "props": {
        "done": 0
      },
      "triggers": [
        {
          "on": "pressed",
          "key": "use",
          "within": 2,
          "when": {
            "prop": "done",
            "is": "==",
            "value": 0
          },
          "do": [
            {
              "op": "setProp",
              "key": "done",
              "value": 1,
              "target": "self"
            },
            {
              "op": "addProp",
              "key": "tasks",
              "value": 1,
              "target": "world"
            },
            {
              "op": "addProp",
              "key": "shifts",
              "value": 1,
              "target": "world"
            },
            {
              "op": "score",
              "amount": 1
            },
            {
              "op": "sound",
              "sound": "thud"
            },
            {
              "op": "emit",
              "event": "task-done"
            }
          ]
        }
      ]
    },
    "wiring": {
      "model": "furniture/cabinet_small",
      "collider": "auto",
      "props": {
        "done": 0
      },
      "triggers": [
        {
          "on": "pressed",
          "key": "use",
          "within": 2,
          "when": {
            "prop": "done",
            "is": "==",
            "value": 0
          },
          "do": [
            {
              "op": "setProp",
              "key": "done",
              "value": 1,
              "target": "self"
            },
            {
              "op": "addProp",
              "key": "tasks",
