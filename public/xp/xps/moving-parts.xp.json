{
  "format": "xp/1",
  "id": "moving-parts",
  "name": "Moving parts",
  "blurb": "Two rooms joined by a corridor, and everything a script can do that a verb cannot. A lift carries you to a ledge no jump reaches, a block patrols the gap in the dividing wall, a coin orbits and says so when you take it. Through the corridor is a pitch with a goal at each end.",
  "finish": "galaxy",
  "packs": [
    {
      "id": "proto"
    },
    {
      "id": "dummy"
    }
  ],
  "capabilities": [
    "freeplay",
    "match",
    "football"
  ],
  "spawn": {
    "x": 0,
    "y": 1,
    "z": 8,
    "facing": 180
  },
  "player": {
    "blueprint": "body"
  },
  "scripts": {
    "patrol": "\nconst REACH = 3.4\nconst PACE = 3.2\n\nlet going = 1\n\nfunction onTick(dt) {\n  self.x += going * PACE * dt\n  if (self.x > REACH) { self.x = REACH; going = -1 }\n  if (self.x < -REACH) { self.x = -REACH; going = 1 }\n}\n",
    "orbit": "\nconst RADIUS = 3\nconst CENTRE = { x: 7, z: 7 }\nconst SPEED = 1.1\nconst DEGREES = 180 / Math.PI\n\nfunction onTick() {\n  const angle = world.time * SPEED\n  self.moveTo(CENTRE.x + Math.cos(angle) * RADIUS, 1.6, CENTRE.z + Math.sin(angle) * RADIUS)\n  self.rotation = -angle * DEGREES\n}\n",
    "watcher": "\nlet nearest = 99\n\nfunction onSpawn() {\n  log('watching for the block')\n}\n\nfunction onTick() {\n  const block = getEntityByName('block')\n  if (!block) return\n\n  const range = self.flatDistanceTo(block)\n  self.set('range', Math.round(range * 10) / 10)\n\n  if (range < nearest - 0.05) {\n    nearest = range\n    log('the block came within', Math.round(range * 10) / 10, 'metres')\n  }\n\n  // Turned to face it, which is the readable half: you can see what it is\n  // looking at without reading a number.\n  self.rotation = Math.atan2(block.x - self.x, block.z - self.z) * (180 / Math.PI)\n}\n",
    "lift": "\nconst LOW = 1\nconst HIGH = 5\nconst PACE = 1.4\n\nlet going = 1\n\nfunction onTick(dt) {\n  self.y += going * PACE * dt\n  if (self.y >= HIGH) { self.y = HIGH; going = -1 }\n  if (self.y <= LOW) { self.y = LOW; going = 1 }\n}\n"
  },
