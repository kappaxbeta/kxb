    "./net": "./src/net/session.ts",
    "./wire": "./src/net/wire.ts",
    "./arbiter": "./src/net/arbiter.ts",
    "./art": "./src/art/sprites.ts",
    "./characters": "./src/art/characters.ts",
    "./play": "./src/play/game.tsx",
    "./ears": "./src/play/ears.ts"
  }
}
