{
  "name": "kxb",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "./scripts/dev.sh",
    "dev-css-classname": "./scripts/dev-css-classname.sh",
    "build": "bun run boxing:publish && bun run maumau:publish && next build",
    "start": "next start",
    "lint": "eslint",
    "typegen": "next typegen",
    "typecheck": "next typegen && tsc --noEmit",
    "typecheck:fast": "next typegen && tsgo --noEmit --tsBuildInfoFile tsconfig.tsgo.tsbuildinfo",
    "test": "bun test src packages",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:migrate": "supabase migration up --local --include-all y",
    "db:types": "./scripts/db-types.sh",
    "geo:update": "bun run scripts/update-geoip.ts",
    "worlds:seed": "bun run scripts/seed-worlds.ts",
    "models:thumbs": "bun run scripts/render-models.ts",
    "mail:art": "bun run scripts/render-email-art.ts",
    "mail:build": "bun run scripts/build-mail-templates.ts",
    "xp:pack": "bun run scripts/xp-pack.ts",
    "boxing:assets": "bun run scripts/boxing-assets.ts",
    "boxing:publish": "bun run scripts/boxing-assets.ts --publish",
    "maumau:assets": "bun run scripts/maumau-assets.ts",
    "maumau:cards": "bun run scripts/maumau-cards.ts",
    "maumau:publish": "bun run scripts/maumau-assets.ts --publish",
    "xp:shapes": "bun run scripts/xp-shapes.ts",
    "xp:vendor": "mkdir -p public/xp/vendor && cp node_modules/p5/lib/p5.min.js public/xp/vendor/p5.min.js",
    "xp:catalogue": "bun run scripts/xp-catalogue.ts",
    "xp:wasm": "bun run scripts/xp-wasm.ts",
    "xp:clips": "bun run scripts/xp-clips.ts",
    "xp:thumbs": "bun run scripts/xp-thumbs.ts",
    "xp:covers": "bun run scripts/xp-covers.ts",
    "xp:measure": "bun run scripts/xp-measure.ts",
    "xp:shot": "bun run scripts/xp-shot.ts",
    "xp:arbiter": "bun run scripts/xp-arbiter.ts",
    "render:worker": "bun run scripts/render-worker.ts",
    "xp:bench": "bun run scripts/xp-bench.ts",
    "xp:e2e": "playwright test",
    "xp:e2e:head": "--HEAD playwright test",
    "test:core": "./tools/test-core.sh"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "@kxb/community": "workspace:*",
    "@kxb/dream-restaurant": "workspace:*",
    "@kxb/maumau": "workspace:*",
    "@kxb/peepz-world": "workspace:*",
    "@kxb/xp": "workspace:*",
    "@react-three/drei": "^10.7.7",
    "@react-three/xr": "^6.6.30",
    "@shadcn/react": "^0.2.1",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "@tiptap/extension-code-block-lowlight": "^3.29.0",
    "@tiptap/extension-highlight": "^3.29.0",
    "@tiptap/extension-image": "^3.29.0",
    "@tiptap/extension-link": "^3.29.0",
    "@tiptap/extension-placeholder": "^3.29.0",
    "@tiptap/extension-table": "^3.29.0",
    "@tiptap/extension-task-item": "^3.29.0",
    "@tiptap/extension-task-list": "^3.29.0",
    "@tiptap/extension-typography": "^3.29.0",
    "@tiptap/pm": "^3.29.0",
    "@tiptap/react": "^3.29.0",
    "@tiptap/starter-kit": "^3.29.0",
    "@tiptap/suggestion": "^3.29.0",
    "@types/three": "^0.185.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "dockview": "7",
    "dockview-react": "7",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.28.0",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "react-resizable-panels": "^4.12.2",
    "recharts": "3.8.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.16.1",
    "sharp": "^0.34.5",
    "stripe": "^22.3.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@playwright/test": "^1.62.1",
    "@react-three/fiber": "^9.6.1",
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.3.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "babel-loader": "^10.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "p5": "^2.3.2",
    "supabase": "^2.109.1",
    "tailwindcss": "^4",
    "three": "^0.185.1",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
